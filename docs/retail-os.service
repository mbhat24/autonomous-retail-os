[Unit]
Description=Autonomous Retail OS
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/autonomous-retail-os
Environment="PATH=/home/pi/autonomous-retail-os/.venv/bin"
ExecStart=/home/pi/autonomous-retail-os/.venv/bin/retail-os server --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
